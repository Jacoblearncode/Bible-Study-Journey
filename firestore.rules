rules_version = '2';

// See docs/firestore-schema.md for the data model and rationale behind
// these rules. Deploy with `firebase deploy --only firestore:rules` once
// you've run `firebase login` locally — this repo doesn't do that for you.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(circleId) {
      return exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
    }

    function isAdminOf(circleId) {
      return isMember(circleId) &&
        get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /circles/{circleId} {
      allow read: if isSignedIn();
      // Circle creation/renaming is an admin-console/Phase-2 concern; no
      // client-side create/update/delete for now.
      allow write: if false;

      match /members/{memberId} {
        allow read: if isSignedIn();
        // Users can add themselves as a plain member (join) or remove
        // themselves (leave); only an existing admin can set someone's role.
        allow create: if isSignedIn() && request.auth.uid == memberId
          && request.resource.data.role == 'member';
        allow update: if isSignedIn() && isAdminOf(circleId);
        allow delete: if isSignedIn() && (request.auth.uid == memberId || isAdminOf(circleId));
      }
    }

    match /posts/{postId} {
      allow read: if isSignedIn() && isMember(resource.data.circleId);
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && isMember(request.resource.data.circleId);
      allow update: if isSignedIn() && request.auth.uid == resource.data.authorId;
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.authorId || isAdminOf(resource.data.circleId));
    }

    match /highlights/{highlightId} {
      allow read, write: if isSignedIn()
        && request.auth.uid == (request.resource.data.userId != null ? request.resource.data.userId : resource.data.userId);
    }
  }
}
