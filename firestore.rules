rules_version = '2';

// See docs/firestore-schema.md for the data model and rationale behind
// these rules. Deploy with `firebase deploy --only firestore:rules` once
// you've run `firebase login` locally — this repo doesn't do that for you.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(circleId) {
      return exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
    }

    function isAdminOf(circleId) {
      return isMember(circleId) &&
        get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Firestore requires this separate top-level wildcard match to authorize
    // collectionGroup('members') queries (used by subscribeToUserCircles to
    // list every circle a user belongs to) — a rule nested under
    // circles/{circleId} only covers direct-path access (get, or a plain
    // collection query already scoped to one circle's members), not a
    // cross-circle collection group list.
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn();
    }

    match /circles/{circleId} {
      allow read: if isSignedIn();
      // Any signed-in user (including guests) can create a circle, as
      // themselves as the creator. Renaming/deleting a circle is deferred.
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;

      match /members/{memberId} {
        // Users can add themselves as a plain member (join by knowing the
        // circle id) or remove themselves (leave). The one exception: the
        // circle's own creator may add themselves as 'admin' instead of
        // 'member' — checked against the circle doc's createdBy, not just
        // "any admin can promote anyone" — so this can't be used to
        // self-promote in someone else's circle. Only an existing admin can
        // change someone else's role after that.
        allow create: if isSignedIn() && request.auth.uid == memberId && (
          request.resource.data.role == 'member' ||
          (request.resource.data.role == 'admin' &&
            get(/databases/$(database)/documents/circles/$(circleId)).data.createdBy == request.auth.uid)
        );
        allow update: if isSignedIn() && isAdminOf(circleId);
        allow delete: if isSignedIn() && (request.auth.uid == memberId || isAdminOf(circleId));
      }
    }

    match /posts/{postId} {
      allow read: if isSignedIn() && isMember(resource.data.circleId);
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && isMember(request.resource.data.circleId);
      allow update: if isSignedIn() && request.auth.uid == resource.data.authorId;
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.authorId || isAdminOf(resource.data.circleId));
    }

    match /highlights/{highlightId} {
      // request.resource doesn't exist at all for reads (get/list), and
      // resource doesn't exist for create — a single ternary referencing
      // both crashes list queries with "Property resource is undefined"
      // rather than gracefully short-circuiting. Split by operation instead.
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create, update: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
  }
}
