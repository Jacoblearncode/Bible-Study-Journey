# Copy this file to .env.local and fill in real values from
# Firebase Console -> Project Settings -> Your apps -> SDK setup and configuration.
#
# These are safe to expose in the client bundle (that's what EXPO_PUBLIC_ means) —
# Firebase's web config identifies the project, it isn't a secret. Access control
# is enforced by Firestore/Auth security rules, not by hiding this file.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: only needed once Google sign-in is configured (see docs/firestore-schema.md).
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=

# Optional: only needed for photo attachments on the daily reading log.
# Create a free Cloudinary account (cloudinary.com), then in Settings -> Upload
# add an "Unsigned" upload preset (Settings -> Upload -> Upload presets -> Add
# upload preset -> Signing Mode: Unsigned). Unsigned presets are safe to use
# from the client — no API secret involved, same as the Firebase config above.
# Without these two set, the app just won't show the "Add photo" button.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
